<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+（API 31+）的自动备份/设备迁移规则。
     同样排除 Keystore 加密的安全偏好（API Key），原因同 backup_rules.xml。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="secure_api_config.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="secure_api_config.xml" />
    </device-transfer>
</data-extraction-rules>
